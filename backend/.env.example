# Runtime
# One of: development | test | production. Defaults to development.
NODE_ENV=
# Defaults to 8080.
PORT=

# Encryption
# bcrypt cost factor. Minimum 10, defaults to 12.
BCRYPT_SALT=
# REQUIRED. Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime: a positive integer followed by s, m, h or d (e.g. 15m, 1d).
# A bare number or anything above 30d is rejected at boot. Defaults to 1d.
JWT_EXPIRATION=

# Database
# REQUIRED. PostgreSQL connection string used by Prisma Client.
DATABASE_URL=
# Direct (non-pooled) connection string used by Prisma Migrate.
DIRECT_URL=

# HTTP
# Comma-separated list of allowed browser origins.
# REQUIRED when NODE_ENV=production.
CORS_ALLOWED_ORIGINS=
# Shared with the web, which sends it beside the address of the client it
# forwards a sign-in or sign-up for; the API believes that address only then.
# Minimum 32 characters, the same value on both. REQUIRED when NODE_ENV=production.
# Generate with: openssl rand -base64 48
API_PROXY_SECRET=

# Market data
# YH Finance API key (https://financeapi.net), sent only from the backend.
# Leave blank to run without quotes: every quote is reported as unavailable.
YAHOO_FINANCE_API_KEY=
# brapi API key (https://brapi.dev, free plan), sent only from the backend. It
# reads the catalog of B3 tickers an import resolves its symbols from. Leave
# blank to look every symbol up in YH Finance, spending its quota.
BRAPI_API_KEY=

# Bot protection
# Cloudflare Turnstile secret key, verified server-side on sign-in and sign-up.
# REQUIRED when NODE_ENV=production, where Cloudflare's test secrets are
# refused. Left blank outside production, the check is off. For local testing,
# 1x0000000000000000000000000000000AA always passes (pair it with the web's test
# site key 1x00000000000000000000AA).
TURNSTILE_SECRET_KEY=
