# Runtime
# One of: development | test | production. Defaults to development.
NODE_ENV=
# Defaults to 8080.
PORT=

# Encryption
# bcrypt cost factor. Minimum 10, defaults to 12.
BCRYPT_SALT=
# REQUIRED. Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime: a positive integer followed by s, m, h or d (e.g. 15m, 1d).
# A bare number or anything above 30d is rejected at boot. Defaults to 1d.
JWT_EXPIRATION=

# Database
# REQUIRED. PostgreSQL connection string used by Prisma Client.
DATABASE_URL=
# Direct (non-pooled) connection string used by Prisma Migrate.
DIRECT_URL=

# HTTP
# Comma-separated list of allowed browser origins.
# REQUIRED when NODE_ENV=production.
CORS_ALLOWED_ORIGINS=
