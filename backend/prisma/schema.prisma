// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model User {
  id             String     @id @default(uuid())
  name           String?
  email          String     @unique
  password       String
  portfolios     Portfolio[]
  /// Sign-up issues the first token at the initial value; sign-in, sign-out
  /// and password change bump it. An access token is honoured only while it
  /// carries the current value.
  sessionVersion Int         @default(0)
  isAdmin        Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("users")
}

model Portfolio {
  id           String        @id @default(uuid())
  name         String
  baseCurrency String
  assets       Asset[]
  transactions Transaction[]
  user         User?         @relation(fields: [userId], references: [id])
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@map("portfolios")
}

enum InstrumentType {
  STOCK
  ETF
  FUND
  REIT
  CRYPTO
  BOND
  TREASURY
  CASH
  OTHER
}

model Instrument {
  id           String         @id @default(uuid())
  symbol       String         @unique
  name         String
  type         InstrumentType
  market       String?
  currency     String?
  sector       String?
  country      String?
  assets       Asset[]
  transactions Transaction[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("instruments")
}

model Asset {
  id           String     @id @default(uuid())
  amount       Float      @default(0)
  balance      Float      @default(0)
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId String
  portfolio    Portfolio  @relation(fields: [portfolioId], references: [id])
  portfolioId  String

  @@unique([portfolioId, instrumentId])
  @@index([instrumentId])
  @@map("assets")
}

model Transaction {
  id           String     @id @default(uuid())
  type         String
  amount       Float
  price        Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  portfolio    Portfolio  @relation(fields: [portfolioId], references: [id])
  portfolioId  String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId String

  @@index([portfolioId, instrumentId])
  @@index([instrumentId])
  @@map("transactions")
}
