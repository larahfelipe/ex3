// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model User {
  id             String     @id @default(uuid())
  name           String?
  email          String     @unique
  password       String
  portfolios     Portfolio[]
  /// Sign-up issues the first token at the initial value; sign-in, sign-out
  /// and password change bump it. An access token is honoured only while it
  /// carries the current value.
  sessionVersion Int         @default(0)
  isAdmin        Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("users")
}

model Portfolio {
  id           String        @id @default(uuid())
  name         String
  baseCurrency String
  positions    Position[]
  transactions Transaction[]
  user         User?         @relation(fields: [userId], references: [id])
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@map("portfolios")
}

enum InstrumentType {
  STOCK
  ETF
  FUND
  REIT
  CRYPTO
  BOND
  TREASURY
  CASH
  OTHER
}

model Instrument {
  id           String         @id @default(uuid())
  symbol       String         @unique
  name         String
  type         InstrumentType
  market       String?
  currency     String?
  sector       String?
  country      String?
  positions    Position[]
  transactions Transaction[]
  marketQuotes MarketQuote[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("instruments")
}

model MarketQuote {
  id           String     @id @default(uuid())
  price        Decimal    @db.Decimal(38, 18)
  currency     String
  source       String
  /// The close of a trading day, at the start of that day in UTC, so an
  /// instrument has one row per trading day and source.
  timestamp    DateTime
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId String
  createdAt    DateTime   @default(now())

  @@unique([instrumentId, timestamp, source])
  @@map("market_quotes")
}

model ExchangeRate {
  id           String   @id @default(uuid())
  currency     String
  baseCurrency String
  rate         Decimal  @db.Decimal(38, 18)
  source       String
  /// The close of a trading day, at the start of that day in UTC, so a pair of
  /// currencies has one row per trading day and source.
  timestamp    DateTime
  createdAt    DateTime @default(now())

  @@unique([currency, baseCurrency, timestamp, source])
  @@map("exchange_rates")
}

model Position {
  id            String     @id @default(uuid())
  quantity      Decimal    @default(0) @db.Decimal(38, 18)
  averageCost   Decimal    @default(0) @db.Decimal(38, 18)
  investedValue Decimal    @default(0) @db.Decimal(38, 18)
  instrument    Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId  String
  portfolio     Portfolio  @relation(fields: [portfolioId], references: [id])
  portfolioId   String

  @@unique([portfolioId, instrumentId])
  @@index([instrumentId])
  @@map("positions")
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  JCP
  INTEREST
  DEPOSIT
  WITHDRAWAL
  SPLIT
  BONUS
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

model Transaction {
  id           String          @id @default(uuid())
  sequence     BigInt          @unique @default(autoincrement())
  type         TransactionType
  quantity     Decimal         @db.Decimal(38, 18)
  unitPrice    Decimal         @db.Decimal(38, 18)
  fees         Decimal         @default(0) @db.Decimal(38, 18)
  taxes        Decimal         @default(0) @db.Decimal(38, 18)
  currency     String
  executedAt   DateTime
  broker       String?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  portfolio    Portfolio       @relation(fields: [portfolioId], references: [id])
  portfolioId  String
  instrument   Instrument      @relation(fields: [instrumentId], references: [id])
  instrumentId String

  @@index([portfolioId, instrumentId])
  @@index([instrumentId])
  @@map("transactions")
}
