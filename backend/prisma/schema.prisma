generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model User {
  id             String      @id @default(uuid())
  /// The full name: `fullName(firstName, lastName)`, in
  /// `src/domain/PersonName.ts`, written together with them.
  name           String?
  firstName      String?
  lastName       String?
  email          String      @unique
  password       String
  portfolios     Portfolio[]
  sessionVersion Int         @default(0)
  isAdmin        Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("users")
}

model Portfolio {
  id           String              @id @default(uuid())
  name         String
  /// The name as the unique index compares it: `portfolioNameKey(name)`, in
  /// `src/domain/PortfolioName.ts`.
  nameKey      String
  baseCurrency String
  positions    Position[]
  transactions Transaction[]
  imports      TransactionImport[]
  user         User?               @relation(fields: [userId], references: [id])
  userId       String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([userId, nameKey])
  @@index([userId])
  @@map("portfolios")
}

enum InstrumentType {
  STOCK
  ETF
  FUND
  REIT
  CRYPTO
  BOND
  TREASURY
  CASH
  OTHER
}

model Instrument {
  id           String         @id @default(uuid())
  symbol       String
  name         String
  type         InstrumentType
  market       String?
  currency     String?
  sector       String?
  country      String?
  /// The user who registered a private instrument, null for the shared
  /// catalog. The unique index treats nulls as equal (NULLS NOT DISTINCT, set in
  /// the migration because the schema cannot express it), so the catalog holds
  /// one instrument per symbol and each user one private instrument per symbol.
  ownerId      String?
  positions    Position[]
  transactions Transaction[]
  marketQuotes MarketQuote[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([ownerId, symbol])
  @@map("instruments")
}

model MarketQuote {
  id           String     @id @default(uuid())
  price        Decimal    @db.Decimal(38, 18)
  currency     String
  source       String
  timestamp    DateTime
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId String
  createdAt    DateTime   @default(now())

  @@unique([instrumentId, timestamp, source])
  @@map("market_quotes")
}

model ExchangeRate {
  id           String   @id @default(uuid())
  currency     String
  baseCurrency String
  rate         Decimal  @db.Decimal(38, 18)
  source       String
  timestamp    DateTime
  createdAt    DateTime @default(now())

  @@unique([currency, baseCurrency, timestamp, source])
  @@map("exchange_rates")
}

model Position {
  id            String     @id @default(uuid())
  quantity      Decimal    @default(0) @db.Decimal(38, 18)
  averageCost   Decimal    @default(0) @db.Decimal(38, 18)
  investedValue Decimal    @default(0) @db.Decimal(38, 18)
  instrument    Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId  String
  portfolio     Portfolio  @relation(fields: [portfolioId], references: [id])
  portfolioId   String

  @@unique([portfolioId, instrumentId])
  @@index([instrumentId])
  @@map("positions")
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  JCP
  INTEREST
  DEPOSIT
  WITHDRAWAL
  SPLIT
  BONUS
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

model Transaction {
  id           String             @id @default(uuid())
  sequence     BigInt             @unique @default(autoincrement())
  type         TransactionType
  quantity     Decimal            @db.Decimal(38, 18)
  unitPrice    Decimal            @db.Decimal(38, 18)
  fees         Decimal            @default(0) @db.Decimal(38, 18)
  taxes        Decimal            @default(0) @db.Decimal(38, 18)
  currency     String
  executedAt   DateTime
  broker       String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  portfolio    Portfolio          @relation(fields: [portfolioId], references: [id])
  portfolioId  String
  instrument   Instrument         @relation(fields: [instrumentId], references: [id])
  instrumentId String
  importKey    String?
  importedRow  Json?
  import       TransactionImport? @relation(fields: [importId], references: [id])
  importId     String?

  @@unique([portfolioId, importKey])
  @@index([portfolioId, instrumentId])
  @@index([instrumentId])
  @@index([importId])
  @@map("transactions")
}

model TransactionImport {
  id                  String        @id @default(uuid())
  fileName            String
  fileDigest          String
  formats             String[]
  rowCount            Int
  importedCount       Int
  openedInstrumentIds String[]
  createdAt           DateTime      @default(now())
  undoneAt            DateTime?
  portfolio           Portfolio     @relation(fields: [portfolioId], references: [id])
  portfolioId         String
  transactions        Transaction[]

  @@index([portfolioId, createdAt])
  @@map("transaction_imports")
}

enum ExpenseCategory {
  HOUSING
  UTILITIES
  FOOD
  TRANSPORTATION
  HEALTH
  EDUCATION
  LEISURE
  SUBSCRIPTIONS
  FINANCIAL
  SHOPPING
  OTHER
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  PIX
  BOLETO
  DIRECT_DEBIT
  OTHER
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum FinanceRecordType {
  EXPENSE
  INSTALLMENT_PLAN
  RECURRING_EXPENSE
}

enum FinanceEventType {
  CREATED
  UPDATED
  CANCELLED
  RESTORED
  PAYMENT_RECORDED
  PAYMENT_CORRECTED
  PAYMENT_VOIDED
  RESCHEDULED
}

model Expense {
  id                 String            @id @default(uuid())
  description        String
  category           ExpenseCategory
  subcategory        String?
  amount             Decimal           @db.Decimal(38, 18)
  currency           String
  entryDate          DateTime          @db.Date
  dueDate            DateTime          @db.Date
  paymentMethod      PaymentMethod?
  account            String?
  notes              String?
  settledAmount      Decimal           @default(0) @db.Decimal(38, 18)
  settledOn          DateTime?         @db.Date
  cancelledAt        DateTime?
  installmentPlan    InstallmentPlan?  @relation(fields: [installmentPlanId], references: [id])
  installmentPlanId  String?
  installmentNumber  Int?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  recurringExpenseId String?
  occurrenceDate     DateTime?         @db.Date
  isCustomized       Boolean           @default(false)
  payments           ExpensePayment[]
  userId             String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([installmentPlanId, installmentNumber])
  @@unique([recurringExpenseId, occurrenceDate])
  @@index([userId, dueDate])
  @@map("expenses")
}

model ExpensePayment {
  id        String         @id @default(uuid())
  amount    Decimal        @db.Decimal(38, 18)
  discount  Decimal        @default(0) @db.Decimal(38, 18)
  fees      Decimal        @default(0) @db.Decimal(38, 18)
  paidOn    DateTime       @db.Date
  method    PaymentMethod?
  notes     String?
  voidedAt  DateTime?
  expense   Expense        @relation(fields: [expenseId], references: [id])
  expenseId String
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([expenseId])
  @@index([userId, paidOn])
  @@map("expense_payments")
}

model InstallmentPlan {
  id              String              @id @default(uuid())
  description     String
  category        ExpenseCategory
  subcategory     String?
  currency        String
  frequency       RecurrenceFrequency @default(MONTHLY)
  principalAmount Decimal?            @db.Decimal(38, 18)
  paymentMethod   PaymentMethod?
  account         String?
  notes           String?
  entryDate       DateTime            @db.Date
  cancelledAt     DateTime?
  installments    Expense[]
  userId          String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId])
  @@map("installment_plans")
}

model RecurringExpense {
  id               String              @id @default(uuid())
  description      String
  category         ExpenseCategory
  subcategory      String?
  amount           Decimal             @db.Decimal(38, 18)
  isVariable       Boolean             @default(false)
  currency         String
  frequency        RecurrenceFrequency
  startDate        DateTime            @db.Date
  endDate          DateTime?           @db.Date
  paymentMethod    PaymentMethod?
  account          String?
  notes            String?
  generatedThrough DateTime            @db.Date
  cancelledAt      DateTime?
  occurrences      Expense[]
  userId           String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([userId])
  @@map("recurring_expenses")
}

model FinanceEvent {
  id         String            @id @default(uuid())
  recordType FinanceRecordType
  recordId   String
  type       FinanceEventType
  changes    Json
  userId     String
  createdAt  DateTime          @default(now())

  @@index([recordType, recordId, createdAt])
  @@index([userId])
  @@map("finance_events")
}

model FinanceSettings {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  reminderLeadDays           Int      @default(3)
  remindOverdue              Boolean  @default(true)
  remindUpcomingBills        Boolean  @default(true)
  remindUpcomingInstallments Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("finance_settings")
}

model RateLimitCounter {
  key     String   @id
  hits    Int
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limit_counters")
}
