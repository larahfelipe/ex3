{
  "name": "backend",
  "version": "0.0.0",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/larahfelipe/ex3"
  },
  "author": {
    "name": "larahfelipe",
    "url": "https://github.com/larahfelipe"
  },
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node dist/Server.js",
    "dev": "tsx watch src/Server.ts",
    "build": "tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --max-warnings=0 --fix",
    "prettier": "prettier --check \"src/**/*.ts\"",
    "prettier:fix": "prettier \"src/**/*.ts\" --write",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --env-file=.env.test --import tsx --test \"src/**/*.test.ts\"",
    "test:unit:watch": "node --env-file=.env.test --import tsx --test --watch \"src/**/*.test.ts\"",
    "test:integration": "node --env-file=.env.test --import tsx src/test/PrepareTestDatabase.ts && node --env-file=.env.test --import tsx --test-concurrency=1 --test \"src/**/*.integration.ts\"",
    "test:db:up": "docker compose --file ../compose.yaml up --detach --wait postgres-test",
    "test:db:down": "docker compose --file ../compose.yaml rm --stop --force postgres-test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^7.10.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-helpers": "^2.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
