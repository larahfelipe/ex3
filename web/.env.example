API_URL=
# The API's API_PROXY_SECRET, so the API throttles sign-in and sign-up per
# client instead of counting every visitor as one. REQUIRED in production.
API_PROXY_SECRET=
# Cloudflare Turnstile site key, rendered on the sign-in and sign-up forms; the
# API's TURNSTILE_SECRET_KEY is its pair. REQUIRED in production, where the API
# refuses every sign-in and sign-up without a solved challenge. Left blank
# elsewhere, no challenge is shown. For local testing, 1x00000000000000000000AA
# always passes and 2x00000000000000000000AB always fails.
TURNSTILE_SITE_KEY=
