# Read by compose.yaml. Copy to .env, which git ignores, and fill in.

# REQUIRED. Password of the development database, interpolated into its URL.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# REQUIRED. Backend token signing secret, at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Shared by the backend and the web, so the API throttles sign-in and sign-up
# per browser rather than per web server. Leave blank to count them together.
# Generate with: openssl rand -base64 48
API_PROXY_SECRET=

# Linux only. Your user and group ids (`id -u`, `id -g`): the development
# containers run with them to write into the mounted code. Leave blank for 1000;
# Docker Desktop needs no value. A change requires recreating the dependency
# volumes; see docs/containers.md.
HOST_UID=
HOST_GID=

# YH Finance API key (https://financeapi.net), sent only from the backend.
# Leave blank to run without quotes: every quote is reported as unavailable.
YAHOO_FINANCE_API_KEY=

# brapi API key (https://brapi.dev, free plan), sent only from the backend. It
# reads the catalog of B3 tickers an import resolves its symbols from. Leave
# blank to look every symbol up in YH Finance, spending its quota.
BRAPI_API_KEY=

# Cloudflare Turnstile keys, a pair: the web shows the challenge with the site
# key and the backend verifies it with the secret. Leave both blank to run
# without the challenge. To try it locally, Cloudflare's test pair always
# passes: 1x00000000000000000000AA and 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
