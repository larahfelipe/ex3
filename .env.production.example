# Read by compose.prod.yaml through `--env-file`. Copy it out of the checkout,
# to ~/.config/ex3-prod/production.env, fill it in and `chmod 600` it. Generate
# every secret anew: never reuse a development value. See docs/deployment.md.

# REQUIRED. Token of the Cloudflare Tunnel (Zero Trust › Networks › Tunnels ›
# your tunnel › Docker), whose public hostname points to http://web:3000.
CLOUDFLARE_TUNNEL_TOKEN=

# REQUIRED. The public origin, exactly as the browser shows it.
CORS_ALLOWED_ORIGINS=https://ex3.example.com

# REQUIRED. Supabase's Session pooler (Connect › Session pooler), which answers
# over IPv4, followed by the parameters that verify the server's certificate
# against Supabase's CA. A password with reserved URL characters is
# percent-encoded.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/database_ca

# REQUIRED. Absolute host path of Supabase's CA certificate (Database settings ›
# SSL Configuration › Download certificate), readable by the container: chmod
# 644. A CA certificate is public, not a secret.
DATABASE_CA_CERT=/home/ubuntu/.config/ex3-prod/supabase-ca.crt

# REQUIRED. At least 32 characters. Rotating it signs everyone out.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# REQUIRED. Shared by the web and the backend. At least 32 characters.
# Generate with: openssl rand -base64 48
API_PROXY_SECRET=

# REQUIRED. Cloudflare Turnstile pair of a widget whose hostnames include the
# production one. Cloudflare's test keys are refused in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# YH Finance (https://financeapi.net) and brapi (https://brapi.dev) keys, sent
# only from the backend. Without the first every quote is unavailable; without
# the second imports look every symbol up in YH Finance.
YAHOO_FINANCE_API_KEY=
BRAPI_API_KEY=
